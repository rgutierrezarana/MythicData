# ==============================================================================
# Configuración del Entorno MTG Big Data Ingestion (Airflow + PySpark + Postgres)
# ==============================================================================

AIRFLOW_UID=50000

_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_DB_MTG=mtg_dw

SPARK_MASTER=spark://spark-master:7077
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=9090

# Observabilidad Distribuida & Jaeger Tracing (OpenTracing / OpenTelemetry)
ENABLE_TRACING=true
JAEGER_HOST=jaeger
JAEGER_PORT=6831
JAEGER_UI_URL=http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_SERVICE_NAME=mtg-spark-pipeline

DATA_DIR=/opt/airflow/data
